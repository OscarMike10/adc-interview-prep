<pre><span class="comment"># Step 1 — 30-second picture</span>
<span class="cmd">top</span>                          <span class="comment"># CPU, memory, load average, top processes</span>
<span class="cmd">htop</span>                         <span class="comment"># Same but easier to read, sort with F6</span>
 
<span class="comment"># Step 2 — CPU deep dive</span>
<span class="cmd">ps aux --sort=-%cpu | head -20</span>   <span class="comment"># Top CPU consumers</span>
<span class="cmd">mpstat -P ALL 1</span>              <span class="comment"># Per-core CPU usage</span>
 
<span class="comment"># Step 3 — Memory</span>
<span class="cmd">free -h</span>                      <span class="comment"># Total/used/available — watch "available" not "free"</span>
<span class="cmd">vmstat 1 5</span>                   <span class="comment"># si/so = swap in/out. r = run queue. Non-zero si/so = bad</span>
 
<span class="comment"># Step 4 — Disk I/O</span>
<span class="cmd">iostat -xz 1</span>                 <span class="comment"># %util near 100% = disk saturated. await = wait time</span>
<span class="cmd">iotop</span>                        <span class="comment"># Which processes are doing heavy disk I/O</span>
 
<span class="comment"># Step 5 — Network</span>
<span class="cmd">ss -tulnp</span>                    <span class="comment"># Open ports and listening services</span>
<span class="cmd">netstat -i</span>                   <span class="comment"># Interface stats — errors and drops</span>
 
<span class="comment"># Step 6 — Logs</span>
<span class="cmd">journalctl -xe</span>               <span class="comment"># Recent system errors</span>
<span class="cmd">tail -f /var/log/messages</span>    <span class="comment"># Live system log</span>
 
<span class="comment"># Step 7 — Disk space (always check this)</span>
<span class="cmd">df -h</span>                        <span class="comment"># Full disk causes cascading failures</span>
<span class="cmd">du -sh /var/log/* | sort -rh | head -10</span>  <span class="comment"># What's consuming space</span></pre>
 
